# Slack Bridge Environment Configuration Example
# Copy this to .env or set as environment variables

# Slack Bot Token (xoxb-...)
PI_SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack App Token (xapp-...)
PI_SLACK_APP_TOKEN=xapp-your-slack-app-token

# Slack User Token (xoxp-..., user scope chat:write) - optional.
# Lets the bridge delete your own messages from its session threads when old interactions are pruned.
# PI_SLACK_USER_TOKEN=xoxp-your-slack-user-token
